      "parameters": {
        "jsCode": "const now = new Date();\nconst madridDate = new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Madrid' }).format(now);\nconst yesterday = new Date(madridDate);\nyesterday.setDate(yesterday.getDate() - 1);\nconst date = yesterday.toISOString().split('T')[0];\n\nreturn [{ json: { date } }];"
      },
      "id": "BuildDate",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const date = $('Code in JavaScript').item.json.date;\nconst text = $input.item.json.data;\n\nconst lines = text.trim().split('\\n');\nconst headers = lines[0].split(',');\nconst rows = lines.slice(1).map(line => {\n  const vals = line.split(',');\n  return Object.fromEntries(headers.map((h, i) => [h, vals[i] ?? '']));\n});\n\n// Agrupa por hora → tabla wide (24 filas)\nconst byHour = {};\nrows.forEach(r => {\n  if (!byHour[r.hour]) {\n    byHour[r.hour] = {\n      date: r.date, year: r.year, month: r.month,\n      day: r.day, hour: r.hour, time: r.time,\n      latitude: r.latitude, longitude: r.longitude\n    };\n  }\n  byHour[r.hour][r.variable] = r.value;\n});\n\nconst wideRows = Object.values(byHour)\n  .sort((a, b) => a.hour.localeCompare(b.hour));\n\nreturn [{ json: { date, wideRows } }];"
      },
      "id": "BuildCurated",
      "name": "Code in JavaScript1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        272,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const { date, wideRows } = $input.item.json;\n\nreturn [{\n  json: {\n    date,\n    rows: wideRows,\n    path: `curated/hourly_environment_wide/date=${date}/hourly_environment_wide_${date}.csv`\n  }\n}];"
      },
