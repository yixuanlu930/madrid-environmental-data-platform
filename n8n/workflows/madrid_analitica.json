{
  "id": "madrid_analitica",
  "name": "Madrid 3 - Analítica",
  "active": true,
  "nodes": [
    {
      "parameters": {},
      "id": "ManualTrigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-600, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://etl:8000/analytics",
        "sendQuery": false,
        "options": { "timeout": 120000 }
      },
      "id": "RunAnalytics",
      "name": "Ejecutar Analítica",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-320, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "CheckAnalytics",
      "name": "Analítica OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-60, 0]
    },
    {
      "parameters": {},
      "id": "LogSuccess",
      "name": "Log success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [200, -100]
    },
    {
      "parameters": {},
      "id": "LogError",
      "name": "Log error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [200, 100]
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [[{ "node": "Ejecutar Analítica", "type": "main", "index": 0 }]]
    },
    "Ejecutar Analítica": {
      "main": [[{ "node": "Analítica OK?", "type": "main", "index": 0 }]]
    },
    "Analítica OK?": {
      "main": [
        [{ "node": "Log success", "type": "main", "index": 0 }],
        [{ "node": "Log error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {}
}
