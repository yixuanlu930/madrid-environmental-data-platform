{
  "id": "madrid_preprocesamiento",
  "name": "Madrid 2 - Preprocesamiento",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "triggerAtHour": 6,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "ScheduleTrigger",
      "name": "Daily Schedule 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-600, -80]
    },
    {
      "parameters": {},
      "id": "ManualTrigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-600, 120]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://etl:8000/preprocess",
        "sendQuery": false,
        "options": { "timeout": 120000 }
      },
      "id": "RunPreprocess",
      "name": "Ejecutar Preprocesamiento",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-320, 20]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "id": "status-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "CheckPreprocess",
      "name": "Preprocesamiento OK?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-60, 20]
    },
    {
      "parameters": {},
      "id": "LogSuccess",
      "name": "Log success",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [200, -80]
    },
    {
      "parameters": {},
      "id": "LogError",
      "name": "Log error",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [200, 120]
    }
  ],
  "connections": {
    "Daily Schedule 06:00": {
      "main": [[{ "node": "Ejecutar Preprocesamiento", "type": "main", "index": 0 }]]
    },
    "Manual Trigger": {
      "main": [[{ "node": "Ejecutar Preprocesamiento", "type": "main", "index": 0 }]]
    },
    "Ejecutar Preprocesamiento": {
      "main": [[{ "node": "Preprocesamiento OK?", "type": "main", "index": 0 }]]
    },
    "Preprocesamiento OK?": {
      "main": [
        [{ "node": "Log success", "type": "main", "index": 0 }],
        [{ "node": "Log error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "staticData": null,
  "meta": { "templateCredsSetupCompleted": true },
  "pinData": {}
}
